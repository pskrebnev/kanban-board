FRONTEND_HOST_PORT=3000
FRONTEND_CONTAINER_PORT=80

BACKEND_HOST_PORT=8080
BACKEND_CONTAINER_PORT=8080

POSTGRES_HOST_PORT=5432
POSTGRES_CONTAINER_PORT=5432
POSTGRES_DB=ticketing
POSTGRES_USER=kanban_user
POSTGRES_PASSWORD=change_this_local_password

DATABASE_URL=postgresql://kanban_user:change_this_local_password@db:5432/ticketing

# Base URL of the SPA, used to build links (e.g. email verification) in later phases.
APP_BASE_URL=http://localhost:3000

# Secret used to sign session JWTs (Phase 2). Generate a long random value; do not commit a real secret.
JWT_SECRET=change_this_local_jwt_secret

# SMTP configuration for email verification (Phase 2).
# Production must support relay1.dataart.com. For local testing, point at Mailpit (see below).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kanban.local

# Mailpit (local mail catcher) host port mappings, used by the test compose profile.
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

E2E_APP_URL=http://frontend
